# Variabili d'ambiente del trader per Docker. Copia in .env (chmod 600) e riempi,
# oppure su AWS lascia che lo generi deploy/aws/fetch-env.sh da SSM Parameter Store.
# .env è ignorato da git: le chiavi non devono mai finire nel repository.

# app.alpaca.markets → Paper Trading → API Keys (chiavi del conto PAPER)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# @BotFather → /newbot, e il chat id da getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# sul tuo computer: claude setup-token (poi copia qui il token che stampa)
CLAUDE_CODE_OAUTH_TOKEN=
